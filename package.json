{
  "name": "freshroots-planner",
  "version": "1.0.0",
  "description": "Twice-weekly demand planner for Freshroots (MESA Case A)",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sample": "tsx scripts/make-sample-data.ts 2026-10-22 data/sample",
    "plan": "tsx scripts/run.ts data/sample 2026-10-22 out",
    "backtest": "tsx scripts/backtest.ts",
    "prototype": "tsx prototype/build.ts",
    "case": "tsx scripts/run-case.ts data/case 2026-10-22",
    "desk": "tsx prototype/build-desk.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import": "tsx scripts/db-import-case.ts data/case"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "type": "module",
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@vercel/functions": "^3.1.0",
    "next": "15.5.28",
    "pg": "^8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  }
}
